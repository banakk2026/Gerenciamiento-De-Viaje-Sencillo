<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Gerenciamiento de Viaje</title>
<style>
:root{--bg:#f6f5f2;--card:#fff;--ink:#1c1b19;--mut:#6b6862;--line:#dedbd4;--ac:#d6191f;--acs:#fdecec;--wb:#fff3c4;--wi:#5c4200;--bb:#fdecec;--bi:#a31217;--ob:#e6f4ea;--oi:#1d6b34;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#171613;--card:#211f1b;--ink:#f0eee9;--mut:#a29e95;--line:#3a3731;--ac:#ef4a50;--acs:#3a1f20;--wb:#3d3213;--wi:#f3d98a;--bb:#3d1b1c;--bi:#ff9a9e;--ob:#16301f;--oi:#8fd9a3;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#171613;--card:#211f1b;--ink:#f0eee9;--mut:#a29e95;--line:#3a3731;--ac:#ef4a50;--acs:#3a1f20;--wb:#3d3213;--wi:#f3d98a;--bb:#3d1b1c;--bi:#ff9a9e;--ob:#16301f;--oi:#8fd9a3;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:760px;margin:0 auto;padding:16px}
.top{display:flex;align-items:center;gap:14px;margin-bottom:14px}
.logo{height:44px;background:#fff;padding:4px 8px;border-radius:8px;border:1px solid var(--line)}
h1{font-size:20px;margin:0}.top p{margin:0;color:var(--mut);font-size:13px}
.prog{height:6px;background:var(--line);border-radius:3px;overflow:hidden}
#bar{height:100%;background:var(--ac);transition:width .25s}
#no{margin:8px 0;color:var(--mut);font-size:13px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
h2{font-size:18px;margin:0 0 12px}
.note{background:var(--wb);color:var(--wi);padding:10px 12px;border-radius:8px;font-size:14px;margin:0 0 14px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.full{grid-column:1/-1}
label.f span,legend{display:block;font-size:14px;font-weight:600;margin-bottom:4px}
input[type=text],input[type=tel],input[type=date],input[type=time],textarea{width:100%;padding:10px 12px;font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px}
input:focus,textarea:focus{outline:2px solid var(--ac);outline-offset:1px}
fieldset{border:0;padding:0;margin:0 0 14px;grid-column:1/-1}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip input,.opt input{position:absolute;opacity:0;pointer-events:none}
.chip span{display:inline-block;padding:9px 18px;border:1px solid var(--line);border-radius:999px;cursor:pointer;font-weight:600}
.chip input:checked+span{background:var(--ac);border-color:var(--ac);color:#fff}
.chip input:focus-visible+span,.opt:has(input:focus-visible){outline:2px solid var(--ac);outline-offset:2px}
.opt{display:flex;justify-content:space-between;gap:10px;position:relative;padding:10px 12px;border:1px solid var(--line);border-radius:10px;margin-bottom:6px;cursor:pointer}
.opt:has(input:checked){border-color:var(--ac);background:var(--acs)}
.opt b{white-space:nowrap;color:var(--mut)}
.ban{padding:10px 12px;border-radius:8px;font-size:14px;font-weight:600;margin:10px 0}
.ban.w{background:var(--wb);color:var(--wi)}.ban.b{background:var(--bb);color:var(--bi)}.ban.o{background:var(--ob);color:var(--oi)}
.tot{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-top:10px}
.tot strong{font-size:28px}
dl{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;font-size:14px;margin:12px 0}dt{color:var(--mut)}dd{margin:0}
.nav{display:flex;justify-content:space-between;gap:10px;margin-top:14px}
button{font:inherit;font-weight:600;padding:11px 20px;border-radius:10px;border:1px solid var(--ac);background:var(--ac);color:#fff;cursor:pointer}
button.g{background:transparent;color:var(--ink);border-color:var(--line)}
button:disabled{opacity:.4;cursor:default}
#msg{color:var(--bi);font-size:14px;min-height:20px;margin-top:8px}
</style>
</head>
<body>
<main class="wrap">
<header class="top"><img class="logo" alt="Wenlen S.A." src="data:image/png;base64,"><div><h1>Gerenciamiento de Viaje</h1><p>R-MAS-01-04 · Rev. 02</p></div></header>
<div class="prog"><div id="bar"></div></div>
<p id="no"></p>
<section class="card"><h2 id="st"></h2><div id="body"></div><div id="msg" role="alert"></div></section>
<nav class="nav" id="nav"><button class="g" id="prev">Anterior</button><button id="next">Siguiente</button></nav>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
const $=id=>document.getElementById(id);
const E=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fd=s=>s?s.split('-').reverse().join('/'):'';
const RISK={
A:['Distancia a recorrer',[['Menos de 50 Km',1],['Menos de 100 Km',2],['Menos de 200 Km',5],['Más de 200 Km',8]]],
B:['Clima-Terreno',[['Seco / Condiciones normales',1],['Lluvia suave / Barro / Viento',2],['Lluvia fuerte y/o niebla',4],['Nieve / Hielo',8]]],
C:['Vehículos y personas',[['2 o + vehículos con 2 o + personas por vehículo',1],['2 o + vehículos con 1 o + personas por vehículo',2],['1 vehículo con 2 o + personas por vehículo',3],['1 vehículo con 1 persona',8]]],
D:['Condiciones de ruta',[['Pavimentada',1],['Mixta (<50% no pavimentada)',2],['No pavimentada',3]]],
E:['Comunicaciones disponibles',[['Teléfono celular',0],['Sin comunicación y en caravana',4],['Sin comunicación y sin caravana',6]]],
F:['Hs. trabajadas + tiempo de viaje',[['Menos de 12 hs',1],['Menos de 14 hs',3],['Menos de 16 hs',6]]],
G:['Hora del traslado',[['Día (07hs - 19hs) Invierno',1],['Noche (19hs - 07hs) Invierno',8],['Día (06hs - 21hs) Verano',1],['Noche (21hs - 06hs) Verano',8]]],
H:['Documentación',[['Posee toda la documentación vigente',0],['Documentación incompleta',17]]]};
const SN=['SI','NO'],LV=['Riesgo bajo','Riesgo medio','Riesgo alto'],AU=['Supervisor','Coordinador','Gerencia'];
const pt=k=>S['r'+k]==null?0:RISK[k][1][S['r'+k]][1];
const tot=()=>Object.keys(RISK).reduce((a,k)=>a+pt(k),0);
const lvl=()=>{const t=tot();return t<20?0:t<24?1:2};
const ban=(c,t)=>`<div class="ban ${c}">${t}</div>`;
const slBan=()=>S.q3==='NO'?ban('b','Si el conductor no durmió al menos 6 hs, NO DEBE CONDUCIR.'):'';
const nightBan=()=>(S.rG===1||S.rG===3)?ban('w','Manejo nocturno: requiere aprobación del Coordinador de línea o Gerente Administrativo.'):'';
const riskSum=()=>ban('b','Horas de trabajo + horas de viaje &gt; 16: NO CONDUCIR.')+nightBan()+
 `<div class="tot"><span>Evaluación del viaje (total)<br><small>${S.rA!=null&&S.rH!=null?LV[lvl()]+' · Autoriza '+AU[lvl()]:''}</small></span><strong>${tot()}</strong></div>`+
 ban('w','Todo viaje hacia o desde Operaciones mayor a 400 km debe ser Gerenciado.');
const S={};let step=0;
const STEPS=[
{t:'Datos del viaje',f:[['fecha','Fecha','date'],['hora','Hora de salida','time'],['origen','Origen','text'],['destino','Destino','text']]},
{t:'1. Información general: vehículo y conductor',f:[['tipo','Tipo de vehículo','text'],['patente','Patente','text'],['interno','Interno','text'],['marca','Marca','text'],['empVeh','¿Vehículo de la empresa?','r',SN],['contr','Nombre de la empresa contratista','text'],['cond','Conductor','text'],['celCond','Número celular','tel'],['lic','Licencia N°','text'],['cat','Categoría','text'],['venc','Fecha de vencimiento','date']]},
{t:'1. Información general: ruta y acompañantes',f:[['ruta','Ruta a seguir','a'],['tiempo','Tiempo de viaje','text'],['llegada','Hora estipulada de llegada','time'],['ac1','Acompañante 1','text'],['ac1c','Número celular','tel'],['ac2','Acompañante 2','text'],['ac2c','Número celular','tel'],['ac3','Acompañante 3','text'],['ac3c','Número celular','tel']]},
{t:'2. Sitios de reporte y descanso',n:'Para viajes superiores a 2 horas.',f:[1,2,3,4,5,6].flatMap(i=>[['p'+i,'Punto N°'+i,'text'],['h'+i,'Hora','time']])},
{t:'3. Análisis de riesgo (A–D)',k:['A','B','C','D']},
{t:'3. Análisis de riesgo (E–H)',k:['E','F','G','H'],post:riskSum},
{t:'4. Lista de verificación de pre viaje',req:['q1','q2','q3'],f:[['q1','¿El conductor tiene conocimiento de los riesgos locales (estado de las rutas, clima, peatones, animales en ruta, etc.)?','r',SN],['q2','¿Se realizó el check list diario del vehículo?','r',SN],['q3','¿El conductor durmió por lo menos 6 hs previas al viaje? Si la respuesta es “NO”, Ud. NO DEBE CONDUCIR','r',SN]],post:slBan},
{t:'5. Aprobación',pre:()=>ban('o',`Según el puntaje (${tot()}) corresponde: ${LV[lvl()]} · Autoriza ${AU[lvl()]}.`)+nightBan(),n:'La firma se completa a mano sobre el PDF impreso.',f:[['aprob','Firma y aclaración de quién aprueba','text'],['cargo','Cargo','text'],['tel','Aprobación telefónica','r',SN]]},
{t:'Resumen y descarga',sum:1}];
function fld([id,l,ty,o]){
 if(ty==='r')return `<fieldset><legend>${l}</legend><div class="chips">${o.map(v=>`<label class="chip"><input type="radio" name="${id}" value="${v}"${S[id]===v?' checked':''}><span>${v}</span></label>`).join('')}</div></fieldset>`;
 if(ty==='a')return `<label class="f full"><span>${l}</span><textarea id="${id}" rows="3">${E(S[id])}</textarea></label>`;
 return `<label class="f"><span>${l}</span><input id="${id}" type="${ty==='tel'?'tel':ty}" value="${E(S[id])}"></label>`}
function grp(k){const [t,o]=RISK[k];return `<fieldset><legend>${k} · ${t}</legend>${o.map(([l,p],i)=>`<label class="opt"><input type="radio" name="r${k}" value="${i}"${S['r'+k]===i?' checked':''}><span>${l}</span><b>${p} pts</b></label>`).join('')}</fieldset>`}
function render(){
 const s=STEPS[step];
 $('bar').style.width=step/(STEPS.length-1)*100+'%';
 $('no').textContent=`Paso ${step+1} de ${STEPS.length}`;
 $('st').textContent=s.t;$('msg').textContent='';
 let h=(s.n?`<p class="note">${s.n}</p>`:'')+(s.pre?s.pre():'');
 if(s.f)h+=`<div class="grid">${s.f.map(fld).join('')}</div>`;
 if(s.k)h+=s.k.map(grp).join('');
 if(s.post)h+=s.post();
 if(s.sum)h+=slBan()+nightBan()+`<div class="tot"><span>${LV[lvl()]}<br><small>Autoriza ${AU[lvl()]}</small></span><strong>${tot()}</strong></div>
 <dl><dt>Fecha</dt><dd>${fd(S.fecha)||'-'} ${S.hora||''}</dd><dt>Trayecto</dt><dd>${E(S.origen)||'-'} → ${E(S.destino)||'-'}</dd><dt>Conductor</dt><dd>${E(S.cond)||'-'}</dd><dt>Vehículo</dt><dd>${E(S.tipo)||'-'} ${E(S.patente)}</dd></dl>
 <button id="dl">Descargar PDF</button> <button class="g" id="rs">Nuevo formulario</button>`;
 $('body').innerHTML=h;
 $('prev').disabled=step===0;$('nav').style.display=s.sum?'none':'flex';
 if(s.sum){$('dl').onclick=dl;$('rs').onclick=()=>{if(confirm('¿Borrar todos los datos y empezar de nuevo?')){Object.keys(S).forEach(k=>delete S[k]);step=0;render()}}}}
$('body').addEventListener('input',e=>{const t=e.target;if(t.type!=='radio')S[t.id]=t.value});
$('body').addEventListener('change',e=>{const t=e.target;if(t.type!=='radio')return;S[t.name]=/^r[A-H]$/.test(t.name)?+t.value:t.value;const y=scrollY;render();scrollTo(0,y)});
$('prev').onclick=()=>{step--;render();scrollTo(0,0)};
$('next').onclick=()=>{const s=STEPS[step];
 if(!(s.k?s.k.every(k=>S['r'+k]!=null):s.req?s.req.every(i=>S[i]):true)){$('msg').textContent='Responde todas las preguntas para continuar.';return}
 step++;render();scrollTo(0,0)};
function mk(){
 const d=new window.jspdf.jsPDF({unit:'mm',format:'a4'});d.setLineWidth(.2);
 const X=10,W=190,RH=5.2,SH=4.8,GH=4.4,cw=W/3,GR=[217,217,217],YL=[255,240,150],V=k=>S[k]||'',K=(k,v)=>S[k]===v?'X':'';
 const L={b:1,s:6.8},B={b:1,a:'c',s:9};
 const C=(x,y,w,h,t,o={})=>{
  if(o.f){d.setFillColor(...o.f);d.rect(x,y,w,h,'FD')}else d.rect(x,y,w,h);
  if(t===''||t==null)return;
  const s=o.s||7;d.setFont('helvetica',o.b?'bold':'normal');d.setFontSize(s);d.setTextColor(...(o.c||[0,0,0]));
  const Ls=d.splitTextToSize(String(t),w-2),lh=s*.3528*1.15,y0=y+(h-Ls.length*lh)/2+lh*.78;
  if(o.a==='c')d.text(Ls,x+w/2,y0,{align:'center'});else d.text(Ls,x+1,y0);};
 const R=(y,h,cs)=>{let x=X;cs.forEach(([w,t,o])=>{C(x,y,w,h,t,o);x+=w});return y+h};
 const SEC=(y,t)=>{C(X,y,W,SH,t,{b:1,a:'c',f:GR,s:7.5});return y+SH};
 const OP=(id,v,w=16)=>[[w,v,{b:1,a:'c'}],[7,K(id,v),B]];
 let y=8;
 C(X,y,48,18,'');d.addImage(document.querySelector('.logo').src,'PNG',X+2,y+3,44,14.2);
 C(X+48,y,92,18,'Gerenciamiento de Viaje',{b:1,a:'c',s:12});C(X+140,y,50,18,'R-MAS-01-04\nRev. 02\n\nPágina 1 de 1',{b:1,a:'c',s:7.5});y+=18+2.7;
 y=R(y,RH,[[22,'Fecha',L],[73,fd(S.fecha)],[30,'Hora de Salida',L],[65,V('hora')]]);
 y=R(y,RH,[[22,'Origen',L],[73,V('origen')],[30,'Destino',L],[65,V('destino')]]);
 y=SEC(y,'1. Información General');
 y=R(y,RH,[[26,'Tipo de vehículo:',L],[50,V('tipo')],[16,'Patente',L],[28,V('patente')],[16,'Interno',L],[20,V('interno')],[14,'Marca',L],[20,V('marca')]]);
 y=R(y,RH,[[32,'Vehículo de la empresa',L],[8,'SI',{b:1,a:'c'}],[6,K('empVeh','SI'),B],[8,'NO',{b:1,a:'c'}],[6,K('empVeh','NO'),B],[52,'Nombre de la empresa contratista',L],[78,V('contr')]]);
 y=R(y,RH,[[22,'Conductor',L],[100,V('cond')],[28,'Número Celular',L],[40,V('celCond')]]);
 y=R(y,RH,[[22,'Licencia N°',L],[44,V('lic')],[16,'Categoría',L],[28,V('cat')],[32,'Fecha de vencimiento',L],[48,fd(S.venc)]]);
 y=R(y,RH,[[22,'Ruta a seguir',L],[168,V('ruta')]]);
 y=R(y,RH,[[22,'Tiempo de Viaje',L],[70,V('tiempo')],[40,'Hora estipulada de llegada',L],[58,V('llegada')]]);
 [1,2,3].forEach(i=>{y=R(y,RH,[[22,i==1?'Acompañantes':'',L],[100,V('ac'+i)],[28,'Número Celular',L],[40,V('ac'+i+'c')]])});
 y=SEC(y,'2. Sitios de reporte y descanso (para viajes superiores a 2 horas)');
 [1,3,5].forEach(i=>{y=R(y,RH,[[17,'Punto N°'+i,L],[56,V('p'+i)],[11,'Hora',L],[11,V('h'+i)],[17,'Punto N°'+(i+1),L],[56,V('p'+(i+1))],[11,'Hora',L],[11,V('h'+(i+1))]])});
 y=SEC(y,'3. Análisis de Riesgo');
 const CX=[X,X+54,X+108],CW=[52,52,82],GAP=2.5;
 const grp=(c,y,k)=>{const [t,o]=RISK[k],x=CX[c],w=CW[c];C(x,y,w,GH,k,{b:1,a:'c',s:7});C(x,y+GH,w-10,GH,t,{b:1,s:6.5,a:'c'});C(x+w-10,y+GH,10,GH,'Ptos',{b:1,s:6.5,a:'c'});
  o.forEach(([l,p],i)=>{const on=S['r'+k]===i,f=on?YL:null;C(x,y+GH*(i+2),w-10,GH,l,{s:6,b:on,f});C(x+w-10,y+GH*(i+2),10,GH,String(p),{s:7,b:1,a:'c',f})})};
 ['A','B','C'].forEach((k,i)=>grp(i,y,k));y+=GH*6+GAP;
 ['D','E','F'].forEach((k,i)=>grp(i,y,k));y+=GH*5+GAP;
 grp(0,y,'G');grp(2,y,'H');
 C(CX[1],y+GH,CW[1],GH*5,'Horas de trabajo + Horas de Viajes > 16 NO CONDUCIR',{b:1,a:'c',s:8,f:[255,0,0],c:[255,255,255]});
 C(X,y+GH*6+13,CX[1]+CW[1]-X,18,'Manejo nocturno requiere Aprobación del Coordinador de línea o Gerente Administrativo. Todo viaje hacia o desde Operaciones mayor a 400 km debe ser Gerenciado',{b:1,a:'c',s:7,f:[255,255,0]});
 const ex=CX[2],ey=y+GH*4+GAP;
 C(ex,ey,37,GH,'EVALUACIÓN DEL VIAJE',{b:1,f:GR,a:'c',s:6});
 'ABCDEFGH'.split('').forEach((k,i)=>{C(ex,ey+GH*(i+1),12,GH,k,{b:1,a:'c'});C(ex+12,ey+GH*(i+1),25,GH,S['r'+k]==null?'':String(pt(k)),{a:'c'})});
 C(ex,ey+GH*9,12,GH,'TOTAL',{b:1,a:'c',s:5.5});C(ex+12,ey+GH*9,25,GH,String(tot()),{b:1,a:'c'});
 [[[0,230,0],'0 - 19 (inclusive)',2],[[255,255,0],'20 a 23 (inclusive)',4],[[255,0,0],'> 24',6]].forEach(([f,t,r])=>C(ex+41,ey+GH*r,41,GH,t,{b:1,a:'c',f,s:6.5}));
 y=ey+GH*10;
 C(X,y,W,SH,'Nota: de acuerdo al puntaje obtenido se debe solicitar la Aprobación correspondiente según la siguiente clasificación',{b:1,a:'c',s:6.8,c:[200,0,0]});y+=SH;
 const done=S.rA!=null&&S.rH!=null,lv=lvl();
 [['RIESGO BAJO (evaluación de 0 a 19)',[0,200,0]],['RIESGO MEDIO (evaluación de 20 a 23)',[255,255,0]],['RIESGO ALTO (evaluación mayor a 24)',[255,0,0]]].forEach(([t,f],i)=>C(X+i*cw,y,cw,SH,(done&&lv===i?'[X] ':'')+t,{b:1,a:'c',s:6.5,f}));y+=SH;
 AU.forEach((a,i)=>C(X+i*cw,y,cw,RH,'Autoriza '+a,{b:1,a:'c',s:8,f:done&&lv===i?GR:null}));y+=RH;
 C(X,y,150,SH,'4. Lista de verificación de pre viaje',{b:1,a:'c',f:GR,s:7.5});C(X+150,y,20,SH,'SI',{b:1,a:'c',f:GR});C(X+170,y,20,SH,'NO',{b:1,a:'c',f:GR});y+=SH;
 [['q1','¿El conductor tiene conocimiento de los riesgos locales (Estado de las Rutas, Clima, Peatones, Animales en Ruta, Etc.)?'],['q2','¿Se realizó el check list diario del vehículo?'],['q3','¿El conductor durmió por lo menos 6 hs previas al viaje? Si la respuesta es "NO", Ud. NO DEBE CONDUCIR']].forEach(([k,t])=>{y=R(y,RH,[[150,t,{s:6.8}],[20,K(k,'SI'),B],[20,K(k,'NO'),B]])});
 y=SEC(y,'5. Aprobación');
 C(X,y,95,15,'Firma: ______________________________',{b:1});
 C(X+95,y,95,5,'Firma y aclaración de quién aprueba: '+V('aprob'),{b:1,s:6.8});
 C(X+95,y+5,95,5,'Cargo: '+V('cargo'),{b:1,s:6.8});
 C(X+95,y+10,57,5,'Aprobación Telefónica:',{b:1,s:6.8});
 [['SI',162,0],['NO',181,0]].forEach(([v,x])=>{C(x,y+10,11,5,v,{b:1,a:'c'});C(x+11,y+10,8,5,K('tel',v),B)});
 return d}
async function dl(){
 const note=t=>{$('msg').textContent=t};
 const D=window.claude?await window.claude.use('downloads'):null;
 if(!D){mk().save('Gerenciamiento_Viaje_'+(S.fecha||new Date().toISOString().slice(0,10))+'.pdf');return}
 try{await D.save({filename:'Gerenciamiento_Viaje_'+(S.fecha||new Date().toISOString().slice(0,10))+'.pdf',data:mk().output('blob')});note('')}
 catch(e){if(e&&e.code!=='declined')note('No se pudo guardar el PDF ('+(e.code||'error')+').')}}
render();
</script>
</body>
</html>
